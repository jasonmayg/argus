# ARGUS Environment Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control

# ============================================================================
# API Keys & Credentials
# ============================================================================

# Anthropic API Key (for Claude AI analysis)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-v0-...

# ============================================================================
# Flask Application Settings
# ============================================================================

# Flask environment (development or production)
FLASK_ENV=development

# Enable Flask debug mode (set to False in production)
FLASK_DEBUG=True

# Flask app port
FLASK_PORT=5050

# ============================================================================
# Database Settings
# ============================================================================

# SQLite database path
DATABASE_PATH=./data/fed_news/fed_news.db

# Database backup path (optional)
BACKUP_PATH=./data/fed_news/backups/

# ============================================================================
# Logging Settings
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_PATH=./logs/argus.log

# ============================================================================
# Federal Reserve Crawler Settings
# ============================================================================

# Target year for crawling
CRAWL_YEAR=2026

# Use proxy for crawling (optional)
# CRAWL_PROXY=http://proxy.example.com:8080

# Crawl timeout (seconds)
CRAWL_TIMEOUT=30

# ============================================================================
# Risk Classification Settings
# ============================================================================

# Risk classification config file
RISK_CONFIG_PATH=./risk_classification_en.json

# Keywords config file
KEYWORDS_CONFIG_PATH=./keywords_config.json

# ============================================================================
# Monitoring & Automation Settings
# ============================================================================

# Email for alerts (optional)
# ALERT_EMAIL=admin@example.com

# Daily monitoring time (HH:MM format, 24-hour)
MONITOR_TIME=09:00

# Enable daily monitoring
ENABLE_DAILY_MONITOR=False

# ============================================================================
# Advanced Settings
# ============================================================================

# Enable analytics tracking
ENABLE_ANALYTICS=False

# Max concurrent requests
MAX_CONCURRENT_REQUESTS=5

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# Retry attempts for failed crawls
RETRY_ATTEMPTS=3

# Cache duration (seconds)
CACHE_DURATION=3600

# ============================================================================
# Development Settings (Development Only)
# ============================================================================

# Enable verbose output
VERBOSE=False

# Enable debug logging
DEBUG_LOGGING=False

# Skip SSL verification (NEVER in production)
SKIP_SSL_VERIFY=False

# ============================================================================
# Notes
# ============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Edit .env with your values
#
# 3. Load in Python:
#    from dotenv import load_dotenv
#    import os
#    load_dotenv()
#    api_key = os.getenv('ANTHROPIC_API_KEY')
#
# 4. Security:
#    - Never commit .env to version control
#    - Add .env to .gitignore
#    - Keep API keys secret
#    - Use strong, unique passwords
#
# 5. Development vs Production:
#    - FLASK_ENV=development for testing
#    - FLASK_ENV=production for deployment
#    - FLASK_DEBUG=True only in development
#    - SKIP_SSL_VERIFY=False in production
#
# ============================================================================
