# ARGUS Environment Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control

# ============================================================================
# AI / LLM API Keys
# ============================================================================
# All keys are optional; missing keys disable the corresponding features.
# At least one of (OPENAI_API_KEY, ANTHROPIC_API_KEY, GROQ_API_KEY, GEMINI_API_KEY)
# is required for the AI features (brief, chat, actions, risk scoring) to work.

# Anthropic Claude — used for risk-matrix scoring and actions fallback
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI — used for intelligence brief, Guardian chat, actions generation
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Groq — free tier, fast inference (Phase 0 LLM router target)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — free tier, long-context (Phase 0 LLM router target)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ============================================================================
# External Data API Keys
# ============================================================================

# FRED (Federal Reserve Economic Data) — required only if FRED adapter is enabled
# Get from: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Alpha Vantage — required only for the alpha_vantage Guardian adapter
# Get from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# SEC EDGAR — must identify your app per SEC fair-access policy
# Format: "Your Name your.email@domain.com"
SEC_USER_AGENT=

# ============================================================================
# Server Configuration
# ============================================================================

# Flask/Gunicorn listen port (default: 5050)
PORT=5050

# URL the bridge_manager uses to POST analysis requests
ARGUS_ANALYZE_URL=http://localhost:5050/api/analyze

# ============================================================================
# Admin / Operator Endpoints
# ============================================================================
#
# Optional access token for the /api/admin/* surface (introduced in
# PR #58 — Phase 3E). When this variable is UNSET, the admin
# endpoints (/api/admin/agents, /api/admin/agents/<name>/recent,
# /api/admin/health/rag, /api/admin/rag/stats) are open — same as
# the pre-3E behavior, fine for local dev and private-network test
# deploys.
#
# When SET to any non-empty value, every admin request must carry a
# matching `X-Admin-Token` header or get 401. Use this on any deploy
# that's reachable from the public internet — the admin endpoints
# expose telemetry (request_ids, tool_calls, error messages, output
# previews) that shouldn't be world-readable.
#
# Generate a random token, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# ARGUS_ADMIN_TOKEN=

# ============================================================================
# Phase 3 — Agent feature flags
# ============================================================================
#
# Phase 3C — ResponseAgent path for /api/chat. Off by default; complex
# user queries stay on the legacy single-shot RAG path until ops flips
# this. Accepts: 1, true, yes, on.
# ARGUS_RESPONSE_AGENT_ENABLED=
#
# Phase 3D — ActionsAgent path for /api/actions. Off by default;
# /api/actions uses the legacy single-shot `call_llm` until ops flips
# this. When on, action generation runs Opus 4.7 with tool access
# (cash positions, historical actions, coherence scoring). Any agent
# failure — crash, status=error, malformed JSON, empty actions — falls
# back to legacy automatically so the UI never sees a 500. Accepts:
# 1, true, yes, on.
# USE_ACTIONS_AGENT=

# ============================================================================
# Data Paths
# ============================================================================

# Pipeline data bus root (raw/, analyzed/, processed/, failed/)
ARGUS_STORAGE_DIR=./shared_storage

# SQLite database for news, risk analysis, regulatory changes
ARGUS_NEWS_DB=data/fed_news/argus_news.db

# Cash positions Excel workbook
ARGUS_CASH_XLSX=data/cash_positions.xlsx

# Optional: GCS path for cash positions (overrides local xlsx if set)
# ARGUS_CASH_GCS_PATH=gs://your-bucket/cash_positions.xlsx

# Data alert rules file
ARGUS_THRESHOLDS_FILE=thresholds.json

# Dataset directory used by data_dashboard / Guardian raw browser
ARGUS_DATASET_DIR=./data/datasets

# ============================================================================
# Google Cloud Storage (Guardian live data)
# ============================================================================

# Service account JSON key. Use forward slashes on Windows: C:/argus/key.json
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Optional GCP project hint (usually inferred from credentials)
# GOOGLE_CLOUD_PROJECT=your-project-id

# Guardian snapshot bucket
GUARDIAN_GCS_BUCKET=your-gcs-bucket
GUARDIAN_GCS_PREFIX=
GUARDIAN_GCS_ENABLED=true

# Override path to a specific alerts_latest.json object (rarely needed)
# GUARDIAN_GCS_LATEST_OBJECT=alerts_latest.json

# Raw data layout under the bucket
GUARDIAN_GCS_RAW_PREFIX=raw
GUARDIAN_GCS_RAW_MODE=date_partition
# GUARDIAN_GCS_RAW_DATE=2026-05-11

# Local fallback snapshot path (used if GCS is unreachable or empty)
GUARDIAN_SNAPSHOT_PATH=guardian_poc/data/alerts_latest.json

# Optional outbound webhook for high-severity Guardian alerts
# GUARDIAN_WEBHOOK_URL=https://hooks.slack.com/services/...

# Generic GCS bucket override (used by some data_dashboard helpers)
# ARGUS_GCS_BUCKET=your-gcs-bucket
# ARGUS_GCS_PREFIX=
# ARGUS_GCS_BASE_PREFIX=raw
# ARGUS_GCS_ROOT_PREFIX=
# ARGUS_GCS_KEY_PATH=service-account.json

# Same idea, scoped to the data dashboard tab
# DATA_DASHBOARD_DATA_DIR=./data/datasets
# DATA_DASHBOARD_GCS_PREFIX=raw

# ============================================================================
# Bridge Manager (file-drop pipeline)
# ============================================================================

# Override the directories the bridge watches and writes to (defaults to ARGUS_STORAGE_DIR subdirs)
# BRIDGE_RAW_DIR=./shared_storage/raw
# BRIDGE_ANALYZED_DIR=./shared_storage/analyzed
# BRIDGE_PROCESSED_DIR=./shared_storage/processed
# BRIDGE_FAILED_DIR=./shared_storage/failed

# Polling interval in seconds
BRIDGE_POLL_INTERVAL=5

# HTTP timeout when calling /api/analyze
BRIDGE_REQUEST_TIMEOUT=120

# Retry behavior for failed analyses
BRIDGE_MAX_RETRIES=3
BRIDGE_RETRY_DELAY=10

# ============================================================================
# Cache TTLs (seconds)
# ============================================================================

CASH_CACHE_TTL=300
DATA_ALERT_CACHE_TTL=300
DATA_DASHBOARD_CACHE_TTL=300

# ============================================================================
# Notes
# ============================================================================
#
# 1. Copy this file to .env:
#      macOS/Linux: cp .env.example .env
#      Windows:     copy .env.example .env
#
# 2. Edit .env with your values. The Python apps load it via python-dotenv.
#
# 3. Security:
#    - Never commit .env to version control (already in .gitignore)
#    - Rotate API keys if they leak
#    - On Windows, use forward slashes (C:/argus/...) or escape backslashes (C:\\argus\\...)
#
# ============================================================================
